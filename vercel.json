{
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs"
    },
    "server": {
      "root": "server",
      "entrypoint": "src/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}